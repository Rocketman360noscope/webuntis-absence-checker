# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.

# Preferred for accounts with WebUntis 2FA:
# Either paste the COMPLETE untis://setschool?... QR content here...
WEBUNTIS_QR_URI=

# ...or enter the visible app/QR key directly here.
# Keep this secret: it can be used for app login and for generating the 2FA code.
WEBUNTIS_APP_SECRET=

# Server/school/user identify your WebUntis installation/account.
WEBUNTIS_SERVER=your-school.webuntis.com
WEBUNTIS_SCHOOL=your-school-name
WEBUNTIS_USERNAME=your-username

# The normal WebUntis password is required by the real-browser automation test.
WEBUNTIS_PASSWORD=your-password
WEBUNTIS_USERAGENT=webuntis-absence-checker

# Class/report settings
WEBUNTIS_CLASS=SG8B
WEBUNTIS_CLASS_ID=KL4578

# Optional fixed dates in YYYY-MM-DD format.
# Leave START_DATE empty to use the start of the current WebUntis school year.
START_DATE=
END_DATE=
